{"chapter":{"sura":105,"name_arabic":"الفيل","name_english":"The Elephant","transliteration":"Al-Fil","juz":30,"origin":"Meccan","revelation_order":19,"verse_count":5,"display_basmalah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ"},"verses":[{"sura":105,"aya":1,"key":"105:1","arabic":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَـٰبِ ٱلْفِيلِ","english":"Have you not regarded how your Lord dealt with the army of the elephants?","transliteration_html":"Alam tara kayfa faAAala rabbuka bia<u>s</u><u>ha</u>bi alfeel<b>i</b>","transliteration_text":"Alam tara kayfa faAAala rabbuka biashabi alfeeli"},{"sura":105,"aya":2,"key":"105:2","arabic":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ","english":"Did He not make their stratagems go awry,","transliteration_html":"Alam yajAAal kaydahum fee ta<u>d</u>leel<b>in</b>","transliteration_text":"Alam yajAAal kaydahum fee tadleelin"},{"sura":105,"aya":3,"key":"105:3","arabic":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","english":"and send against them flocks of birds","transliteration_html":"Waarsala AAalayhim <u>t</u>ayran ab<u>a</u>beel<b>a</b>","transliteration_text":"Waarsala AAalayhim tayran ababeela"},{"sura":105,"aya":4,"key":"105:4","arabic":"تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ","english":"pelting them with stones of shale,","transliteration_html":"Tarmeehim bi<u>h</u>ij<u>a</u>ratin min sijjeel<b>in</b>","transliteration_text":"Tarmeehim bihijaratin min sijjeelin"},{"sura":105,"aya":5,"key":"105:5","arabic":"فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ","english":"thus making them like chewed-up straw?","transliteration_html":"FajaAAalahum kaAAa<u>s</u>fin makool<b>in</b>","transliteration_text":"FajaAAalahum kaAAasfin makoolin"}]}