{"chapter":{"sura":100,"name_arabic":"العاديات","name_english":"The Courser","transliteration":"Al-'Adiyat","juz":30,"origin":"Meccan","revelation_order":14,"verse_count":11,"display_basmalah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ"},"verses":[{"sura":100,"aya":1,"key":"100:1","arabic":"وَٱلْعَـٰدِيَـٰتِ ضَبْحًۭا","english":"By the snorting chargers,","transliteration_html":"Wa<b>a</b>lAA<u>a</u>diy<u>a</u>ti <u>d</u>ab<u>ha</u><b>n</b>","transliteration_text":"WaalAAadiyati dabhan"},{"sura":100,"aya":2,"key":"100:2","arabic":"فَٱلْمُورِيَـٰتِ قَدْحًۭا","english":"by the strikers of sparks [with their hoofs],","transliteration_html":"Fa<b>a</b>lmooriy<u>a</u>ti qad<u>ha</u><b>n</b>","transliteration_text":"Faalmooriyati qadhan"},{"sura":100,"aya":3,"key":"100:3","arabic":"فَٱلْمُغِيرَٰتِ صُبْحًۭا","english":"by the raiders at dawn,","transliteration_html":"Fa<b>a</b>lmugheer<u>a</u>ti <u>s</u>ub<u>ha</u><b>n</b>","transliteration_text":"Faalmugheerati subhan"},{"sura":100,"aya":4,"key":"100:4","arabic":"فَأَثَرْنَ بِهِۦ نَقْعًۭا","english":"raising therein a trail of dust,","transliteration_html":"Faatharna bihi naqAA<u>a</u><b>n</b>","transliteration_text":"Faatharna bihi naqAAan"},{"sura":100,"aya":5,"key":"100:5","arabic":"فَوَسَطْنَ بِهِۦ جَمْعًا","english":"and cleaving therein a host!","transliteration_html":"Fawasa<u>t</u>na bihi jamAA<u>a</u><b>n</b>","transliteration_text":"Fawasatna bihi jamAAan"},{"sura":100,"aya":6,"key":"100:6","arabic":"إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌۭ","english":"Indeed man is ungrateful to his Lord,","transliteration_html":"Inna alins<u>a</u>na lirabbihi lakanood<b>un</b>","transliteration_text":"Inna alinsana lirabbihi lakanoodun"},{"sura":100,"aya":7,"key":"100:7","arabic":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ","english":"and indeed he is [himself] witness to that!","transliteration_html":"Wainnahu AAal<u>a</u> <u>tha</u>lika lashaheed<b>un</b>","transliteration_text":"Wainnahu AAala thalika lashaheedun"},{"sura":100,"aya":8,"key":"100:8","arabic":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","english":"And indeed he is an avid lover of wealth.","transliteration_html":"Wainnahu li<u>h</u>ubbi alkhayri lashadeed<b>un</b>","transliteration_text":"Wainnahu lihubbi alkhayri lashadeedun"},{"sura":100,"aya":9,"key":"100:9","arabic":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","english":"Does he not know, when what is [buried] in the graves is turned over,","transliteration_html":"Afal<u>a</u> yaAAlamu i<u>tha</u> buAAthira m<u>a</u> fee alquboor<b>i</b>","transliteration_text":"Afala yaAAlamu itha buAAthira ma fee alquboori"},{"sura":100,"aya":10,"key":"100:10","arabic":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","english":"and what is [concealed] in the breasts is divulged,","transliteration_html":"Wa<u>h</u>u<u>ss</u>ila m<u>a</u> fee a<b>l</b><u>ss</u>udoor<b>i</b>","transliteration_text":"Wahussila ma fee alssudoori"},{"sura":100,"aya":11,"key":"100:11","arabic":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ","english":"on that day their Lord will be well informed about them [and their deeds]?","transliteration_html":"Inna rabbahum bihim yawmai<u>th</u>in lakhabeer<b>un</b>","transliteration_text":"Inna rabbahum bihim yawmaithin lakhabeerun"}]}