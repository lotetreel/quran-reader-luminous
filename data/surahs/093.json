{"chapter":{"sura":93,"name_arabic":"الضحى","name_english":"The Morning Hours","transliteration":"Ad-Duha","juz":30,"origin":"Meccan","revelation_order":11,"verse_count":11,"display_basmalah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ"},"verses":[{"sura":93,"aya":1,"key":"93:1","arabic":"وَٱلضُّحَىٰ","english":"By the morning brightness,","transliteration_html":"Wa<b>al</b><u>dd</u>u<u>ha</u>","transliteration_text":"Waaldduha"},{"sura":93,"aya":2,"key":"93:2","arabic":"وَٱلَّيْلِ إِذَا سَجَىٰ","english":"and by the night when it is calm!","transliteration_html":"Wa<b>a</b>llayli i<u>tha</u> saj<u>a</u>","transliteration_text":"Waallayli itha saja"},{"sura":93,"aya":3,"key":"93:3","arabic":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","english":"Your Lord has neither forsaken you, nor is He displeased with you,","transliteration_html":"M<u>a</u> waddaAAaka rabbuka wam<u>a</u> qal<u>a</u>","transliteration_text":"Ma waddaAAaka rabbuka wama qala"},{"sura":93,"aya":4,"key":"93:4","arabic":"وَلَلْـَٔاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ","english":"and the Hereafter shall be better for you than the world.","transliteration_html":"Walal<u>a</u>khiratu khayrun laka mina alool<u>a</u>","transliteration_text":"Walalakhiratu khayrun laka mina aloola"},{"sura":93,"aya":5,"key":"93:5","arabic":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","english":"Soon your Lord will give you [that with which] you will be pleased.","transliteration_html":"Walasawfa yuAA<u>t</u>eeka rabbuka fatar<u>da</u>","transliteration_text":"Walasawfa yuAAteeka rabbuka fatarda"},{"sura":93,"aya":6,"key":"93:6","arabic":"أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ","english":"Did He not find you an orphan, and shelter you?","transliteration_html":"Alam yajidka yateeman fa<u>a</u>w<u>a</u>","transliteration_text":"Alam yajidka yateeman faawa"},{"sura":93,"aya":7,"key":"93:7","arabic":"وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ","english":"Did He not find you astray, and guide you?","transliteration_html":"Wawajadaka <u>da</u>llan fahad<u>a</u>","transliteration_text":"Wawajadaka dallan fahada"},{"sura":93,"aya":8,"key":"93:8","arabic":"وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ","english":"Did He not find you needy, and enrich you?","transliteration_html":"Wawajadaka AA<u>a</u>ilan faaghn<u>a</u>","transliteration_text":"Wawajadaka AAailan faaghna"},{"sura":93,"aya":9,"key":"93:9","arabic":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","english":"So, as for the orphan, do not oppress him;","transliteration_html":"Faamm<u>a</u> alyateema fal<u>a</u> taqhar","transliteration_text":"Faamma alyateema fala taqhar"},{"sura":93,"aya":10,"key":"93:10","arabic":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","english":"and as for the beggar, do not chide him;","transliteration_html":"Waamm<u>a</u> a<b>l</b>ss<u>a</u>ila fal<u>a</u> tanhar","transliteration_text":"Waamma alssaila fala tanhar"},{"sura":93,"aya":11,"key":"93:11","arabic":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","english":"and as for your Lord’s blessing, proclaim it!","transliteration_html":"Waamm<u>a</u> biniAAmati rabbika fa<u>h</u>addith","transliteration_text":"Waamma biniAAmati rabbika fahaddith"}]}