{"chapter":{"sura":1,"name_arabic":"الفاتحة","name_english":"The Opening","transliteration":"Al-Fatihah","juz":1,"origin":"Meccan","revelation_order":5,"verse_count":7,"display_basmalah":null},"verses":[{"sura":1,"aya":1,"key":"1:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","english":"In the Name of Allah, the All-beneficent, the All-merciful.","transliteration_html":"Bismi All<u>a</U>hi a<b>l</B>rra<u>h</U>m<u>a</U>ni a<b>l</B>rra<u>h</U>eem<b>i</b>","transliteration_text":"Bismi Allahi alrrahmani alrraheemi"},{"sura":1,"aya":2,"key":"1:2","arabic":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ","english":"All praise belongs to Allah, Lord of all the worlds,","transliteration_html":"Al<u>h</U>amdu lill<u>a</U>hi rabbi alAA<u>a</U>lameen<b>a</b>","transliteration_text":"Alhamdu lillahi rabbi alAAalameena"},{"sura":1,"aya":3,"key":"1:3","arabic":"ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","english":"the All-beneficent, the All-merciful,","transliteration_html":"A<b>l</B>rra<u>h</U>m<u>a</U>ni a<b>l</B>rra<u>h</U>eem<b>i</b>","transliteration_text":"Alrrahmani alrraheemi"},{"sura":1,"aya":4,"key":"1:4","arabic":"مَـٰلِكِ يَوْمِ ٱلدِّينِ","english":"Master of the Day of Retribution.","transliteration_html":"M<u>a</U>liki yawmi a<b>l</B>ddeen<b>i</b>","transliteration_text":"Maliki yawmi alddeeni"},{"sura":1,"aya":5,"key":"1:5","arabic":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","english":"You [alone] do we worship, and to You [alone] do we turn for help.","transliteration_html":"Iyy<u>a</U>ka naAAbudu waiyy<u>a</U>ka nastaAAeen<b>u</b>","transliteration_text":"Iyyaka naAAbudu waiyyaka nastaAAeenu"},{"sura":1,"aya":6,"key":"1:6","arabic":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","english":"Guide us on the straight path,","transliteration_html":"Ihdin<u>a</U> a<b>l</B><u>ss</U>ir<u>at</U>a almustaqeem<b>a</b>","transliteration_text":"Ihdina alssirata almustaqeema"},{"sura":1,"aya":7,"key":"1:7","arabic":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّ