{"chapter":{"sura":113,"name_arabic":"الفلق","name_english":"The Daybreak","transliteration":"Al-Falaq","juz":30,"origin":"Meccan","revelation_order":20,"verse_count":5,"display_basmalah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ"},"verses":[{"sura":113,"aya":1,"key":"113:1","arabic":"قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","english":"Say, ‘I seek the protection of the Lord of the daybreak","transliteration_html":"Qul aAAoo<u>th</u>u birabbi alfalaq<b>i</b>","transliteration_text":"Qul aAAoothu birabbi alfalaqi"},{"sura":113,"aya":2,"key":"113:2","arabic":"مِن شَرِّ مَا خَلَقَ","english":"from the evil of what He has created,","transliteration_html":"Min sharri m<u>a</u> khalaq<b>a</b>","transliteration_text":"Min sharri ma khalaqa"},{"sura":113,"aya":3,"key":"113:3","arabic":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","english":"and from the evil of the dark night when it falls,","transliteration_html":"Wamin sharri gh<u>a</u>siqin i<u>tha</u> waqab<b>a</b>","transliteration_text":"Wamin sharri ghasiqin itha waqaba"},{"sura":113,"aya":4,"key":"113:4","arabic":"وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ","english":"and from the evil of the witches, who blow on knots,","transliteration_html":"Wamin sharri a<b>l</b>nnaff<u>a</u>th<u>a</u>ti fee alAAuqad<b>i</b>","transliteration_text":"Wamin sharri alnnaffathati fee alAAuqadi"},{"sura":113,"aya":5,"key":"113:5","arabic":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","english":"and from the evil of the envious one when he envies.’","transliteration_html":"Wamin sharri <u>ha</u>sidin i<u>tha</u> <u>h</u>asad<b>a</b>","transliteration_text":"Wamin sharri hasidin itha hasada"}]}